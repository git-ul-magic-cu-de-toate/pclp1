CC = gcc
CFLAGS = -Wall -Wextra
LDFLAGS = -lm

SRCS = $(sort $(wildcard *.c))
TARGETS = 01-deep_writer 02-deep_reader
TARGET = $(src:.c=)

# build all targets
all: $(TARGETS)

# general rule for building a target
%: %.c student.h student.c
	$(CC) $(CFLAGS) -o $@ student.c $< $(LDFLAGS)

# run a single target
run: $(TARGET)
	./$(TARGET)

# clean all related target files
clean:
	rm -f *.o $(TARGETS)

# pack directory
pack:
	zip -FS $(ZIP).zip *.c *.h Makefile README

.PHONY: pack clean
